# config.env - copy from config.env.example and edit. Plain bash: VAR=value, no spaces around "=".

# ---- required ---------------------------------------------------------------
# Cloud image you downloaded (qcow2). Use the exact file name, no wildcards.
GUEST_IMAGE=$HOME/Downloads/CHANGE-ME.qcow2
# ONE host project folder the VM may read and write, or "none" for no shared folder.
SHARE_DIR=$HOME/working-directory/CHANGE-ME

# ---- recommended ------------------------------------------------------------
# Checksum of the image from the distro's published CHECKSUM file.
#GUEST_IMAGE_SHA256=

# ---- optional (defaults shown) ----------------------------------------------
#VM_NAME=claude-vm
#VM_USER=            # default: your host username
#VM_UID=             # default: your host uid. Keep it equal to the host uid.
#RAM_MB=8192
#VCPUS=4
#DISK_GB=100         # thin-provisioned: only used space is stored; can grow later, not shrink
#GUEST_MOUNT=/home/<user>/working-directory
#OSINFO=fedora-unknown          # for an Ubuntu image try ubuntu-lts-latest; list: virt-install --osinfo list
#NETWORK=default
#URI=qemu:///system
#IMAGES_DIR=/var/lib/libvirt/images
#SSH_KEY=$HOME/.ssh/claude-vm_ed25519
#DOCKER_CMD='curl -fsSL https://get.docker.com | sh'
#CLAUDE_CMD='curl -fsSL https://claude.ai/install.sh | bash'
